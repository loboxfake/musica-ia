<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MusicaIA"
        android:textSize="22sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editTema"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tema (ej: pop alegre)"
         />

    <EditText
        android:id="@+id/editEstilo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Estilo (ej: verano)"
         />

    <ProgressBar
        android:id="@+id/progreso"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />
    <TextView
        android:id="@+id/tiempo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tiempo: 0s"
        android:visibility="gone" />
    <Button
        android:id="@+id/btnCrear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Crear" />

    <TextView
        android:id="@+id/estado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Listo"
        android:textSize="14sp" />

    <ScrollView
        android:id="@+id/scrollResultado"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/textoResultado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resultado..."
                android:textSize="14sp" />
            <ImageView
                android:id="@+id/imgPortada"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:visibility="gone" />
            <Button
                android:id="@+id/btnReproducir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reproducir"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>