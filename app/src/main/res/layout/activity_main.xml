<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootMusicalIA"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#070D19">

    <LinearLayout android:id="@+id/brandHeader" android:layout_width="match_parent" android:layout_height="70dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:background="@drawable/bg_panel" android:elevation="5dp">
        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@mipmap/ic_launcher_foreground" android:background="@drawable/bg_brand_orb" android:padding="4dp" android:scaleType="fitCenter" android:contentDescription="Símbolo de BARDO"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
            <TextView android:id="@+id/tvBrandName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BARDO" android:textColor="#EAF2FF" android:textSize="22sp" android:textStyle="bold" android:fontFamily="sans-serif-smallcaps" android:letterSpacing="0.20"/>
            <TextView android:id="@+id/tvBrandSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SISTEMA PERSONAL · LOCAL FIRST" android:textColor="#68D6E8" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.10"/>
        </LinearLayout>
        <TextView android:id="@+id/btnAtajoSistema" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="⚙" android:textSize="21sp" android:textColor="#DCE8F8" android:background="@drawable/bg_icon_button" android:clickable="true" android:focusable="true" android:contentDescription="Abrir sistema y ajustes"/>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#192E4A"/>
    <ScrollView
        android:id="@+id/scrollMain"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="18dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="16dp"
            android:paddingBottom="30dp">
inearLayout>

            <LinearLayout android:id="@+id/seccionOrquestador" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="01 · ASISTENTE Y ORQUESTACIÓN" android:textColor="#4ED1F1" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.16"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="7dp" android:id="@+id/tvWelcomeTitle" android:text="Tu centro de inteligencia y creación." android:textColor="#F5F8FF" android:textSize="27sp" android:textStyle="bold"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="16dp" android:id="@+id/tvWelcomeDescription" android:text="Conversa, importa conocimiento, organiza proyectos y coordina herramientas locales. Cada módulo muestra su estado real y puede evolucionar sin convertir el núcleo en una pantalla de botones." android:textColor="#A9B8D2" android:textSize="14sp" android:lineSpacingExtra="3dp"/>
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:layout_marginBottom="13dp">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:layout_width="wrap_content" android:layout_height="32dp" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="LOCAL FIRST" android:textColor="#75DCEB" android:textSize="9sp" android:textStyle="bold" android:background="@drawable/bg_icon_button"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginStart="7dp" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="MEMORIA PROPIA" android:textColor="#C4B5FD" android:textSize="9sp" android:textStyle="bold" android:background="@drawable/bg_icon_button"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginStart="7dp" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="ARQUITECTURA MODULAR" android:textColor="#D9C18A" android:textSize="9sp" android:textStyle="bold" android:background="@drawable/bg_icon_button"/>
                    </LinearLayout>
                </HorizontalScrollView>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingBottom="7dp" android:text="ACCESO RÁPIDO A TUS ESPACIOS" android:textColor="#8FA4C1" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.10"/>
                <LinearLayout android:id="@+id/workspaceShortcuts" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="14dp">
                    <TextView android:id="@+id/shortcutStudio" android:layout_width="0dp" android:layout_height="68dp" android:layout_weight="1" android:layout_marginEnd="5dp" android:gravity="center" android:padding="5dp" android:text="♫\nEstudio" android:textColor="#DCEAFF" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/bg_secondary_button" android:clickable="true" android:focusable="true" android:contentDescription="Abrir el estudio musical"/>
                    <TextView android:id="@+id/shortcutLibrary" android:layout_width="0dp" android:layout_height="68dp" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:gravity="center" android:padding="5dp" android:text="▣\nArchivo" android:textColor="#DCEAFF" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/bg_secondary_button" android:clickable="true" android:focusable="true" android:contentDescription="Abrir la biblioteca de audio"/>
                    <TextView android:id="@+id/shortcutEvolution" android:layout_width="0dp" android:layout_height="68dp" android:layout_weight="1" android:layout_marginStart="5dp" android:gravity="center" android:padding="5dp" android:text="⌘\nEvolución" android:textColor="#DCEAFF" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/bg_secondary_button" android:clickable="true" android:focusable="true" android:contentDescription="Abrir modelos y evolución de BARDO"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/panelConversacion" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_generation_card">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <ImageView android:layout_width="50dp" android:layout_height="50dp" android:src="@mipmap/ic_launcher_foreground" android:background="@drawable/bg_brand_orb" android:padding="3dp" android:scaleType="fitCenter" android:contentDescription="Núcleo BARDO"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BARDO · NÚCLEO CENTRAL" android:textColor="#F0F6FF" android:textSize="14sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Conversación · Memoria · Módulos especializados" android:textColor="#A9B8D2" android:textSize="12sp"/>
                        </LinearLayout>
                        <TextView android:id="@+id/tvEstadoLocal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● GEMMA POR VINCULAR" android:textColor="#D9B86B" android:textSize="10sp" android:textStyle="bold" android:contentDescription="Estado del modelo local Gemma"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp" android:layout_marginBottom="12dp" android:background="#29466E"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CONVERSACIÓN" android:textColor="#8FA4C1" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.12"/>
                    <TextView android:id="@+id/chatLog" android:layout_width="match_parent" android:layout_height="0dp" android:visibility="gone"/>
                    <ScrollView android:id="@+id/chatScroll" android:layout_width="match_parent" android:layout_height="270dp" android:fillViewport="true" android:nestedScrollingEnabled="false" android:overScrollMode="ifContentScrolls" android:background="@drawable/bg_generation_card" android:padding="9dp" android:clipToPadding="false">
                        <LinearLayout android:id="@+id/chatMessages" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="8dp" android:paddingBottom="8dp"/>
                    </ScrollView>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="4dp" android:background="@drawable/bg_input">
                        <Button android:id="@+id/btnAdjuntarChat" android:layout_width="46dp" android:layout_height="48dp" android:text="📎" android:textAllCaps="false" android:contentDescription="Adjuntar un archivo de cualquier formato"/>
                        <EditText android:id="@+id/chatEntrada" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:minHeight="54dp" android:paddingStart="12dp" android:paddingEnd="8dp" android:hint="Escribe a BARDO..." android:textColor="#F5F8FF" android:textColorHint="#8396B4" android:background="@android:color/transparent" android:inputType="textCapSentences|textMultiLine" android:maxLines="4"/>
                        <Button android:id="@+id/btnEnviar" android:layout_width="54dp" android:layout_height="50dp" android:layout_marginStart="4dp" android:text="➤" android:textSize="21sp" android:textAllCaps="false" android:textColor="#02081B" android:textStyle="bold" android:background="@drawable/bg_primary_button" android:contentDescription="Enviar mensaje"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="7dp">
                        <Button android:id="@+id/btnNuevaConversacion" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="Nueva conversación" android:textAllCaps="false" android:textSize="11sp"/>
                        <Button android:id="@+id/btnVerHistorial" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:layout_marginStart="6dp" android:text="Historial" android:textAllCaps="false" android:textSize="11sp"/>
                        <Button android:id="@+id/btnActividadBardo" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:layout_marginStart="6dp" android:text="Actividad" android:textAllCaps="false" android:textSize="11sp"/>
                    </LinearLayout>
                    <Button android:id="@+id/btnBuscarHistorial" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="5dp" android:text="Buscar en conversaciones" android:textAllCaps="false" android:textSize="11sp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <Button android:id="@+id/btnExportarHistorial" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="Exportar" android:textAllCaps="false" android:textSize="11sp"/>
                        <Button android:id="@+id/btnImportarHistorial" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:layout_marginStart="6dp" android:text="Importar" android:textAllCaps="false" android:textSize="11sp" android:visibility="gone"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/seccionCrear" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="30dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="02 · ESTUDIO MUSICAL" android:textColor="#4ED1F1" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.16"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="12dp" android:text="Crear, producir y experimentar" android:textColor="#F5F8FF" android:textSize="21sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingBottom="7dp" android:text="ELIGE CÓMO QUIERES CREAR" android:textColor="#8FA4C1" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.10"/>
                <RadioGroup android:id="@+id/grupoModo" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:padding="5dp" android:background="@drawable/bg_panel" android:visibility="visible">
                    <RadioButton android:id="@+id/modoConversacion" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:gravity="center" android:buttonTint="#69D6E8" android:textColor="#DCEAFF" android:textSize="11sp" android:maxLines="2" android:checked="true" android:text="Canción completa"/>
                    <RadioButton android:id="@+id/modoLetra" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:gravity="center" android:buttonTint="#69D6E8" android:textColor="#DCEAFF" android:textSize="11sp" android:maxLines="2" android:text="Mi letra"/>
                    <RadioButton android:id="@+id/modoInstrumental" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:gravity="center" android:buttonTint="#69D6E8" android:textColor="#DCEAFF" android:textSize="11sp" android:maxLines="2" android:text="Solo instrumental"/>
                </RadioGroup>
                <LinearLayout android:id="@+id/panelInstrumental" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:visibility="gone" android:background="@drawable/bg_generation_card" android:padding="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="INSTRUMENTAL IA" android:textColor="#4ED1F1" android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:paddingTop="5dp" android:paddingBottom="9dp"
                        android:text="Describe el sonido que quieres. El orquestador coordinará el motor de audio local."
                        android:textColor="#A9B8D2" android:textSize="12sp"/>
                    <CheckBox android:id="@+id/checkPruebaRapida" android:layout_width="match_parent" android:layout_height="wrap_content" android:buttonTint="#4ED1F1" android:text="Prueba rápida · 1 segmento (validación de audio)" android:textColor="#DCEAFF" android:textSize="13sp" android:paddingTop="6dp" android:paddingBottom="6dp"/>
                    <EditText android:id="@+id/editPromptInstrumental" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:gravity="top" android:minLines="4"
                        android:hint="Ej.: instrumental cinematográfico épico, cuerdas, piano y percusión..."
                        android:textColor="#F5F8FF" android:textColorHint="#8195B4"
                        android:background="@drawable/bg_input" android:inputType="textMultiLine"
                        android:padding="12dp"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/panelLetra" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:background="@drawable/bg_panel" android:padding="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TU LETRA" android:textColor="#4ED1F1" android:textSize="10sp" android:textStyle="bold"/>
                    <EditText android:id="@+id/editLetra" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top" android:minLines="6" android:hint="Pega aquí tu letra completa" android:textColor="#F5F8FF" android:textColorHint="#8195B4" android:background="@drawable/bg_input" android:inputType="textMultiLine" android:padding="12dp"/>
                    <EditText android:id="@+id/editIndicaciones" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:hint="Estilo, ambiente, ritmo..." android:textColor="#F5F8FF" android:textColorHint="#8195B4" android:background="@drawable/bg_input" android:inputType="textCapSentences" android:padding="12dp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_panel" android:padding="14dp" android:layout_marginTop="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TU VOZ · REFERENCIA PARA MEZCLA" android:textColor="#4ED1F1" android:textSize="10sp" android:textStyle="bold"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="4dp" android:paddingBottom="8dp" android:text="Graba o importa tu voz para usarla en una mezcla compatible. No es clonación ni síntesis de voz." android:textColor="#A9B8D2" android:textSize="12sp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <Button android:id="@+id/btnGrabar" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Grabar voz" android:textAllCaps="false"/>
                        <Button android:id="@+id/btnElegirVoz" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Importar audio" android:textAllCaps="false"/>
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingTop="5dp" android:paddingBottom="4dp"
                    android:text="Para una canción completa, conversa primero con el orquestador. Para música sin voz, elige Solo instrumental."
                    android:textColor="#8295B1" android:textSize="11sp"/>
                <TextView android:id="@+id/estadoVoz" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="7dp" android:text="Sin muestra vocal seleccionada." android:textColor="#A9B8D2" android:textSize="12sp"/>
                </LinearLayout>
                <ProgressBar android:id="@+id/progreso" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:visibility="gone"/>
                <TextView android:id="@+id/tvProgresoDetalle" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="4dp" android:text="Preparado para crear" android:textColor="#A9B8D2" android:textSize="12sp" android:visibility="gone"/>
                <TextView android:id="@+id/tiempo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tiempo: 0s" android:textColor="#A9B8D2" android:visibility="gone"/>
                <Button android:id="@+id/btnCrear" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="14dp" android:text="Crear con BARDO  ✦" android:textAllCaps="false" android:textColor="#02081B" android:textStyle="bold" android:background="@drawable/bg_primary_button"/>
                <Button android:id="@+id/btnCancelarTarea" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="7dp" android:text="Solicitar cancelación" android:textAllCaps="false" android:visibility="gone"/>
                <TextView android:id="@+id/estado" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" android:text="Preparado para crear" android:textColor="#A9B8D2" android:textSize="12sp"/>
                <TextView android:id="@+id/textoResultado" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:textColor="#E2EAF7" android:textSize="13sp"/>
                <ImageView android:id="@+id/imgPortada" android:layout_width="200dp" android:layout_height="200dp" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:visibility="gone"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                    <Button android:id="@+id/btnReproducir" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Reproducir" android:textAllCaps="false" android:visibility="gone"/>
                    <Button android:id="@+id/btnGuardar" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Guardar MP3" android:textAllCaps="false" android:visibility="gone"/>
                </LinearLayout>
                <Button android:id="@+id/btnCompartir" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="7dp" android:text="Compartir MP3" android:textAllCaps="false" android:visibility="gone"/>

            </LinearLayout>

            <LinearLayout android:id="@+id/seccionBiblioteca" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="30dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="03 · BIBLIOTECA Y PROYECTOS" android:textColor="#4ED1F1" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.16"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="17dp" android:layout_marginTop="9dp" android:background="@drawable/bg_panel">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tus creaciones y sesiones" android:textColor="#F1F5FF" android:textSize="20sp" android:textStyle="bold"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:id="@+id/tvBiblioteca" android:text="Tus canciones e instrumentales aparecerán aquí cuando se generen." android:textColor="#A9B8D2" android:textSize="13sp" android:lineSpacingExtra="3dp"/>
                    <Button android:id="@+id/btnActualizarBiblioteca" android:layout_width="match_parent"
                        android:layout_height="46dp" android:layout_marginTop="10dp"
                        android:text="Actualizar biblioteca" android:textAllCaps="false"/>
                    <Button android:id="@+id/btnBibliotecaReproducir" android:layout_width="match_parent"
                        android:layout_height="46dp" android:layout_marginTop="7dp"
                        android:text="Reproducir última creación" android:textAllCaps="false"
                        android:visibility="gone"/>
                    <Button android:id="@+id/btnBibliotecaGestionar" android:layout_width="match_parent"
                        android:layout_height="46dp" android:layout_marginTop="7dp"
                        android:text="Buscar, favoritos y listas de reproducción" android:textAllCaps="false"/>
                    <Button android:id="@+id/btnBibliotecaImportar" android:layout_width="match_parent"
                        android:layout_height="46dp" android:layout_marginTop="7dp"
                        android:text="Importar MP3 o WAV a la biblioteca" android:textAllCaps="false"/>
                    <Button android:id="@+id/btnMasterizarWav" android:layout_width="match_parent"
                        android:layout_height="46dp" android:layout_marginTop="7dp"
                        android:text="Masterizar WAV · básico offline" android:textAllCaps="false"/>
                    <Button android:id="@+id/btnMezclarPistasWav" android:layout_width="match_parent"
                        android:layout_height="46dp" android:layout_marginTop="7dp"
                        android:text="Mezclar 2–8 pistas WAV · básico offline" android:textAllCaps="false"/>
                <LinearLayout android:id="@+id/playerControls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="8dp" android:visibility="gone">
                    <SeekBar android:id="@+id/seekPlayback" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="1000" android:contentDescription="Posición de reproducción"/>
                    <TextView android:id="@+id/tvPlaybackTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="00:00 / 00:00" android:textColor="#A9B8D2" android:textSize="12sp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <Button android:id="@+id/btnPausar" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Pausar" android:textAllCaps="false"/>
                        <Button android:id="@+id/btnDetener" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Detener" android:textAllCaps="false"/>
                    </LinearLayout>
                </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/seccionImagenes" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="30dp" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="04 · DIRECCIÓN VISUAL" android:textColor="#4ED1F1" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.16"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="8dp" android:text="Identidad visual de BARDO" android:textColor="#F5F8FF" android:textSize="21sp" android:textStyle="bold"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="17dp" android:layout_marginTop="9dp" android:background="@drawable/bg_panel">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Crea una portada para una canción o disco, genera una imagen independiente a partir de tu descripción o usa el diseño gráfico offline. La generación IA es opcional y requiere Bonsai Image 4B." android:textColor="#A9B8D2" android:textSize="13sp" android:lineSpacingExtra="4dp"/>
                    <Button android:id="@+id/btnCrearPortadaIA" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="12dp" android:text="Crear portada IA para canción o disco" android:textAllCaps="false"/>
                    <Button android:id="@+id/btnCrearImagenIA" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:text="Pedir a BARDO una imagen libre" android:textAllCaps="false"/>
                    <Button android:id="@+id/btnCrearPortada" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:text="Crear portada gráfica offline (sin IA)" android:textAllCaps="false"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/seccionLaboratorio" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="30dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="05 · INTELIGENCIA Y EVOLUCIÓN" android:textColor="#4ED1F1" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.16"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="17dp" android:layout_marginTop="9dp" android:background="@drawable/bg_panel">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Modelos, memoria y autonomía" android:textColor="#F5F8FF" android:textSize="19sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingTop="10dp" android:text="MODELOS LOCALES" android:textColor="#65D5E7" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.10"/>
                    <TextView android:id="@+id/estadoModelo" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:text="Gemma local: comprobando la copia y su integridad…" android:textColor="#A9B8D2" android:textSize="12sp"/>
                    <TextView android:id="@+id/estadoAudioModelo" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="7dp" android:text="Instrumental IA: comprobando motor local..." android:textColor="#A9B8D2" android:textSize="12sp"/>
                    <TextView android:id="@+id/estadoImagenModelo" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="7dp" android:text="Bonsai Image 4B: modelo opcional; estado sujeto a instalación, memoria disponible y prueba en dispositivo." android:textColor="#A9B8D2" android:textSize="12sp"/>
                    <TextView android:id="@+id/estadoVozModelo" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="7dp" android:text="Voz cantada IA: todavía no integrada; no se simula." android:textColor="#E8B987" android:textSize="12sp"/>
                    <ProgressBar android:id="@+id/progresoModelo" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="1000" android:visibility="gone"/>
                    <Button android:id="@+id/btnDescargarModelo" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="Localizar Gemma existente · verificar e importar" android:textAllCaps="false"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingTop="12dp" android:text="MEMORIA Y CONOCIMIENTO" android:textColor="#A99AEF" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.10"/>
                    <TextView android:id="@+id/estadoConocimiento" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:text="Conocimiento importado: ninguno." android:textColor="#A9B8D2" android:textSize="12sp"/>
                    <Button android:id="@+id/btnImportarConocimiento" android:layout_width="match_parent"
                        android:layout_height="48dp" android:layout_marginTop="8dp"
                        android:text="Importar conversación de otro asistente" android:textAllCaps="false" android:visibility="gone"/>
                    <Button android:id="@+id/btnBorrarConocimiento" android:layout_width="match_parent"
                        android:layout_height="46dp" android:layout_marginTop="6dp"
                        android:text="Borrar conocimiento importado" android:textAllCaps="false" android:visibility="gone"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingTop="12dp" android:text="AUTONOMÍA DE DESARROLLO" android:textColor="#D8BC7A" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.10"/>
                    <Button android:id="@+id/btnAbrirDeveloper" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="10dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="BARDO Developer · Autoestudio prioritario" android:textAllCaps="false" android:maxLines="2" android:ellipsize="end" android:visibility="visible"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:text="Próximas capacidades: catálogo de modelos, skills verificadas y memoria de aprendizaje." android:textColor="#8295B1" android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/seccionSistema" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="30dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="06 · ENTORNO Y PREFERENCIAS" android:textColor="#4ED1F1" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.16"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="17dp" android:layout_marginTop="9dp" android:background="@drawable/bg_panel">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Entorno BARDO" android:textColor="#F1F5FF" android:textSize="20sp" android:textStyle="bold"/>
                    <Button android:id="@+id/btnVerCapacidades" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:text="Ver capacidades reales de BARDO" android:textAllCaps="false"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="7dp" android:text="Tu espacio de trabajo, memoria, almacenamiento local, permisos, capacidades, copias y futuras actualizaciones. Los modelos originales permanecen en tus carpetas." android:textColor="#A9B8D2" android:textSize="12sp" android:lineSpacingExtra="4dp"/>
                    <TextView android:id="@+id/tvCarpetaBardo" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" android:text="Descargas/BARDO · acceso a la carpeta pendiente" android:textColor="#A9B8D2" android:textSize="12sp"/>
                    <Button android:id="@+id/btnElegirCarpetaBardo" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="7dp" android:text="Conectar Descargas/BARDO · permiso Android" android:textAllCaps="false"/>
                    <Button android:id="@+id/btnCrearCopiaBardo" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="7dp" android:text="Crear copia de seguridad" android:textAllCaps="false"/>
                    <Button android:id="@+id/btnRestaurarCopiaBardo" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:text="Restaurar copia de seguridad" android:textAllCaps="false"/>
                    <Button android:id="@+id/btnExportarInterfaz" android:layout_width="match_parent"
                        android:layout_height="48dp" android:layout_marginTop="12dp"
                        android:text="Exportar configuración de interfaz" android:textAllCaps="false" android:visibility="gone"/>
                    <Button android:id="@+id/btnImportarInterfaz" android:layout_width="match_parent"
                        android:layout_height="48dp" android:layout_marginTop="7dp"
                        android:text="Importar diseño desde archivo" android:textAllCaps="false" android:visibility="gone"/>
                    <Button android:id="@+id/btnBorrarMemoria" android:layout_width="match_parent"
                        android:layout_height="48dp" android:layout_marginTop="12dp"
                        android:text="Borrar memoria e historial local"
                        android:textAllCaps="false" android:visibility="gone"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:id="@+id/bottomNavigation" android:layout_width="match_parent"
        android:layout_height="72dp" android:orientation="horizontal" android:gravity="center"
        android:paddingStart="4dp" android:paddingEnd="4dp"
        android:background="@drawable/bg_panel" android:elevation="12dp">
        <TextView android:id="@+id/navOrquestador" style="@style/NavItem" android:text="✧\nAsistente" android:contentDescription="Asistente"/>
        <TextView android:id="@+id/navCrear" style="@style/NavItem" android:text="♫\nEstudio" android:contentDescription="Crear música"/>
        <TextView android:id="@+id/navBiblioteca" style="@style/NavItem" android:text="▣\nArchivo" android:contentDescription="Biblioteca de archivos"/>
        <TextView android:id="@+id/navImagenes" style="@style/NavItem" android:text="◈\nImagen" android:contentDescription="Generación de imágenes y portadas"/>
        <TextView android:id="@+id/navLaboratorio" style="@style/NavItem" android:text="⌘\nEvolución" android:contentDescription="Laboratorio y evolución local"/>
        <TextView android:id="@+id/navSistema" style="@style/NavItem" android:text="⚙\nSistema" android:contentDescription="Sistema y ajustes"/>
    </LinearLayout>
</LinearLayout>