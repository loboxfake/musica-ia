<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootMusicalIA"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B1020">
    <ScrollView
        android:id="@+id/scrollMain"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="18dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <LinearLayout android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:background="@drawable/bg_brand_orb">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="♫" android:textColor="#E8F8FF" android:textSize="25sp" android:textStyle="bold"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="11dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MUSICALIA" android:textColor="#F3F7FF" android:textSize="19sp" android:textStyle="bold" android:letterSpacing="0.12"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TU ESTUDIO MUSICAL INTELIGENTE" android:textColor="#8496B3" android:textSize="9sp" android:letterSpacing="0.10"/>
                </LinearLayout>
                <TextView android:layout_width="38dp" android:layout_height="38dp" android:gravity="center" android:text="⚙" android:textSize="20sp" android:textColor="#B9C9E2" android:background="@drawable/bg_icon_button"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/seccionOrquestador" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="28dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CENTRO DE CONTROL" android:textColor="#70D8FF" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.16"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="7dp" android:text="¿Qué vamos a crear hoy?" android:textColor="#F3F7FF" android:textSize="27sp" android:textStyle="bold"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="16dp" android:text="Habla con tu orquestador. Él coordina los modelos y herramientas para convertir tus ideas en música." android:textColor="#9BAAC2" android:textSize="14sp" android:lineSpacingExtra="3dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/panelConversacion" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_panel">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <LinearLayout android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:background="@drawable/bg_brand_orb">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✧" android:textColor="#E8F8FF" android:textSize="30sp"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MUSICALIA CORE" android:textColor="#F0F6FF" android:textSize="14sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Control local · Gemma al instalarlo" android:textColor="#9BAAC2" android:textSize="12sp"/>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● GUIADO" android:textColor="#70D8FF" android:textSize="10sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp" android:layout_marginBottom="12dp" android:background="#2B3850"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CONVERSACIÓN" android:textColor="#8FA4C1" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.12"/>
                    <TextView android:id="@+id/chatLog" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp" android:paddingTop="9dp" android:paddingBottom="10dp" android:text="Orquestador: Estoy aquí para ayudarte a dar forma a tu próxima idea musical. ¿Qué te gustaría crear?" android:textColor="#E2EAF7" android:textSize="14sp" android:lineSpacingExtra="4dp"/>
                    <EditText android:id="@+id/chatEntrada" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:padding="13dp" android:hint="Escribe tu idea o instrucción..." android:textColor="#F3F7FF" android:textColorHint="#788BA8" android:background="@drawable/bg_input" android:inputType="textCapSentences|textMultiLine" android:maxLines="4"/>
                    <Button android:id="@+id/btnEnviar" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:text="Hablar con el orquestador  →" android:textAllCaps="false" android:textColor="#071321" android:textStyle="bold" android:background="@drawable/bg_primary_button"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/seccionCrear" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="30dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ESTUDIO CREATIVO" android:textColor="#70D8FF" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.16"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="12dp" android:text="Tus herramientas musicales" android:textColor="#F3F7FF" android:textSize="21sp" android:textStyle="bold"/>
                <RadioGroup android:id="@+id/grupoModo" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone">
                    <RadioButton android:id="@+id/modoConversacion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="Conversar"/>
                    <RadioButton android:id="@+id/modoLetra" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mi letra"/>
                </RadioGroup>
                <LinearLayout android:id="@+id/panelLetra" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:background="@drawable/bg_panel" android:padding="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TU LETRA" android:textColor="#70D8FF" android:textSize="10sp" android:textStyle="bold"/>
                    <EditText android:id="@+id/editLetra" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top" android:minLines="6" android:hint="Pega aquí tu letra completa" android:textColor="#F3F7FF" android:textColorHint="#788BA8" android:background="@drawable/bg_input" android:inputType="textMultiLine" android:padding="12dp"/>
                    <EditText android:id="@+id/editIndicaciones" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:hint="Estilo, ambiente, ritmo..." android:textColor="#F3F7FF" android:textColorHint="#788BA8" android:background="@drawable/bg_input" android:inputType="textCapSentences" android:padding="12dp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_panel" android:padding="14dp" android:layout_marginTop="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PERFIL VOCAL" android:textColor="#70D8FF" android:textSize="10sp" android:textStyle="bold"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="4dp" android:paddingBottom="8dp" android:text="Añade una muestra de voz para futuras funciones vocales." android:textColor="#9BAAC2" android:textSize="12sp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <Button android:id="@+id/btnGrabar" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Grabar voz" android:textAllCaps="false"/>
                        <Button android:id="@+id/btnElegirVoz" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Importar audio" android:textAllCaps="false"/>
                    </LinearLayout>
                    <TextView android:id="@+id/estadoVoz" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="7dp" android:text="Sin muestra vocal seleccionada." android:textColor="#9BAAC2" android:textSize="12sp"/>
                </LinearLayout>
                <ProgressBar android:id="@+id/progreso" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:visibility="gone"/>
                <TextView android:id="@+id/tiempo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tiempo: 0s" android:textColor="#9BAAC2" android:visibility="gone"/>
                <Button android:id="@+id/btnCrear" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="14dp" android:text="Crear con MusicalIA  ✦" android:textAllCaps="false" android:textColor="#071321" android:textStyle="bold" android:background="@drawable/bg_primary_button"/>
                <TextView android:id="@+id/estado" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" android:text="Preparado para crear" android:textColor="#9BAAC2" android:textSize="12sp"/>
                <TextView android:id="@+id/textoResultado" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:textColor="#E2EAF7" android:textSize="13sp"/>
                <ImageView android:id="@+id/imgPortada" android:layout_width="200dp" android:layout_height="200dp" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:visibility="gone"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                    <Button android:id="@+id/btnReproducir" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Reproducir" android:textAllCaps="false" android:visibility="gone"/>
                    <Button android:id="@+id/btnGuardar" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Exportar MP3 320" android:textAllCaps="false" android:visibility="gone"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/seccionBiblioteca" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="30dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TU ARCHIVO MUSICAL" android:textColor="#70D8FF" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.16"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="17dp" android:layout_marginTop="9dp" android:background="@drawable/bg_panel">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Biblioteca" android:textColor="#F3F7FF" android:textSize="19sp" android:textStyle="bold"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:text="Aquí reuniremos tus canciones, instrumentales, proyectos y perfiles vocales guardados." android:textColor="#9BAAC2" android:textSize="13sp" android:lineSpacingExtra="3dp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/seccionLaboratorio" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="30dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EVOLUCIÓN DEL SISTEMA" android:textColor="#70D8FF" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.16"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="17dp" android:layout_marginTop="9dp" android:background="@drawable/bg_panel">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Laboratorio IA" android:textColor="#F3F7FF" android:textSize="19sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/estadoModelo" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:text="IA local de letras: modelo no descargado." android:textColor="#9BAAC2" android:textSize="12sp"/>
                    <ProgressBar android:id="@+id/progresoModelo" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="1000" android:visibility="gone"/>
                    <Button android:id="@+id/btnDescargarModelo" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="Gestionar modelo Gemma 4 E2B · 2,6 GB" android:textAllCaps="false"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:text="Próximas capacidades: catálogo de modelos, skills verificadas y memoria de aprendizaje." android:textColor="#8295B1" android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/seccionSistema" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="30dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PREFERENCIAS" android:textColor="#70D8FF" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.16"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="17dp" android:layout_marginTop="9dp" android:background="@drawable/bg_panel">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sistema y personalización" android:textColor="#F3F7FF" android:textSize="18sp" android:textStyle="bold"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="7dp" android:text="Diseño modular · Procesamiento local · Control de almacenamiento · Actualizaciones y copias de seguridad." android:textColor="#9BAAC2" android:textSize="12sp" android:lineSpacingExtra="4dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:id="@+id/bottomNavigation" android:layout_width="match_parent"
        android:layout_height="64dp" android:orientation="horizontal" android:gravity="center"
        android:background="#111A2B" android:elevation="12dp">
        <TextView android:id="@+id/navOrquestador" style="@style/NavItem" android:text="✧\nIA"/>
        <TextView android:id="@+id/navCrear" style="@style/NavItem" android:text="♫\nCrear"/>
        <TextView android:id="@+id/navBiblioteca" style="@style/NavItem" android:text="▤\nArchivo"/>
        <TextView android:id="@+id/navLaboratorio" style="@style/NavItem" android:text="◇\nLab"/>
        <TextView android:id="@+id/navSistema" style="@style/NavItem" android:text="⚙\nSistema"/>
    </LinearLayout>
</LinearLayout>