<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MusicalIA" parent="Theme.AppCompat.NoActionBar">
        <item name="colorAccent">#68D6E8</item>
        <item name="android:colorAccent">#68D6E8</item>
        <item name="buttonStyle">@style/BardoButton</item>
        <item name="editTextStyle">@style/BardoEditText</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#050A15</item>
        <item name="android:navigationBarColor">#050A15</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="BardoButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_secondary_button</item>
        <item name="android:textColor">#E0EAF8</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textSize">13sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="BardoEditText" parent="Widget.AppCompat.EditText">
        <item name="android:textColor">#F1F5FC</item>
        <item name="android:textColorHint">#869AB5</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:padding">12dp</item>
    </style>
    <style name="NavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:textColor">#A8B8CC</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>